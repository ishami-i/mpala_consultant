# Copy to backend/.env and fill in. Never commit backend/.env.
# For local testing you can leave most of this out: run.sh fills in what it can.

# --- Database -------------------------------------------------------------
# sqlite = local testing (a single file, nothing to install)
# mysql  = deployment
DB_ENGINE=sqlite
# SQLITE_PATH=backend/database/mpala.sqlite3

# Only used when DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_USER=mpala
DB_PASSWORD=change-this-password
DB_NAME=mpala

# --- Security -------------------------------------------------------------
# Long random value, e.g.:  python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me
# Comma-separated emails allowed to open the dashboard
ADMIN_EMAILS=you@yourcompany.com
# true = anyone can create a user via /api/register. Use false in production.
ALLOW_REGISTRATION=true

# --- Emails ---------------------------------------------------------------
# Where "new project" emails go
COMPANY_EMAIL=info@yourcompany.com
# SMTP login (for Gmail: smtp.gmail.com, 587, True and an app password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=you@yourcompany.com
MAIL_PASSWORD=your-app-password

# --- What clients see in emails ----------------------------------------------
# The address clients reply to and see in the footer. Default: info@<your domain>.
# PUBLIC_EMAIL=info@yourcompany.com
# Public address of the website, for the links in emails. Default: DASHBOARD_URL without /admin.
# SITE_URL=https://yourcompany.com
# Name shown next to the sender address
# MAIL_FROM_NAME=Mpala Consultant

# --- Gallery photos -------------------------------------------------------
# Folder where photos uploaded from the dashboard are saved (back this folder up).
# UPLOAD_DIR=backend/uploads/gallery
# Largest single photo, in MB
# MAX_UPLOAD_MB=8

# --- Addresses ------------------------------------------------------------
# Dashboard link used in the company email
DASHBOARD_URL=http://localhost:5173/admin
# API port (on macOS, 5000 can be taken by AirPlay: use 5001)
BACKEND_PORT=5000
